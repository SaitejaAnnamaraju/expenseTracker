# Copy to .env and fill in real values:  cp .env.example .env
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ---- Server ----
NODE_ENV=development
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string

# ---- MySQL (application user, least privilege) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=expense_tracker
DB_USER=expense_app
DB_PASSWORD=change-me

# ---- MySQL admin (only used by "npm run db:setup" / "npm run db:migrate") ----
DB_ROOT_USER=root
DB_ROOT_PASSWORD=your-mysql-root-password

# ---- Uploads ----
MAX_UPLOAD_MB=5
# Set to true to make a receipt mandatory for every expense
RECEIPT_REQUIRED=false

# ---- Hosted MySQL / Render (leave unset for local MySQL) ----
# DB_SSL=true
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# DB_SSL_REJECT_UNAUTHORIZED=false   # only if your provider supplies no CA
