{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "views/**",
          "public/**",
          "node_modules/chart.js/dist/**",
          "node_modules/lucide/dist/umd/**",
          "node_modules/marked/lib/**",
          "node_modules/dompurify/dist/**"
        ]
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "/api/index.js" }]
}
